// ★ 单实例控制 ★
import process.mutex;

var mutex = process.mutex("qrfs_v2.8_single_instance");

if( mutex.conflict ){
    win.msgbox(`
qrfs 已经在运行了。

请检查系统托盘或任务栏，找到已打开的窗口。
`, "qrfs - 扫码快传",0);
    win.quitMessage();
    return;
}


