// ============================================================
// 【启动】
// ============================================================
var desiredPort = 18900;
if(cfgPort && #string.trim(cfgPort)){
    var p = tonumber(string.trim(cfgPort));
    if(p && p > 0 && p < 32768) desiredPort = p;
}
winform.editPort.text = desiredPort;

try{ srvHttp.close(); }catch(e){}

applyServerConfig();

var actualPort = startWithFallback(desiredPort);
if(actualPort){
    winform.editPort.text = actualPort;
}
else{
    winform.txtMessage.print("无法启动服务，请手动指定端口后点击【重启服务】。");
}

serverInfo();

winform.txtMessage.print("");
if(actualPort && actualPort != desiredPort){
    winform.txtMessage.print("端口 " + desiredPort + " 已被占用，自动切换到 " + actualPort);
}
//winform.txtMessage.print("剪贴板超长提醒：" + config.winform.clipboardMax + " 字节（约 " + math.round(config.winform.clipboardMax/1024) + " KB）");
win.loopMessage();