// 【新增】程序启动时，如果配置文件指定了端口，立即用该端口启动服务
if(cfgPort){
    // 先关闭之前默认启动的随机端口服务
    try{ srvHttp.close(); }
    catch(e){}
    
    srvHttp.documentRoot = fsys.isDir(winform.editDocumentRoot.text) ? winform.editDocumentRoot.text : srvHttp.documentRoot;
    srvHttp.userToken = winform.editPassword.text;
    srvHttp.start("0.0.0.0", tonumber(cfgPort));
    winform.editPort.text = tonumber(cfgPort);
}

serverInfo();

win.loopMessage();